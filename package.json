{
  "name": "codex-stream-deck",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "description": "Unofficial Codex Micro bridge for Stream Deck on Windows and macOS",
  "license": "MIT",
  "author": "xonika9",
  "repository": {
    "type": "git",
    "url": "https://github.com/xonika9/codex-stream-deck.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-launcher.mjs",
    "dev": "node scripts/dev-plugin.mjs",
    "docs:preview": "tsx scripts/generate-doc-preview.ts",
    "qa:local-icons": "tsx scripts/generate-local-icon-qa.ts",
    "audit:release": "node scripts/audit-release.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate": "npm run build && streamdeck validate dist/com.xonika9.codex-deck.sdPlugin",
    "pack": "npm run build && streamdeck pack dist/com.xonika9.codex-deck.sdPlugin --force",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.1",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "imports": {
    "#codex": "./src/codex/index.ts",
    "#opencode": "./src/opencode/index.ts",
    "#agents": "./src/agents/index.ts",
    "#stream-deck": "./src/stream-deck/index.ts",
    "#usage": "./src/usage/index.ts"
  }
}
